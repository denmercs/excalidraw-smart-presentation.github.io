      "link": null,
      "locked": false,
      "text": "The Gospel of John is different  from the Synoptic Gospels\nMatthew, Mark, and Luke",
      "fontSize": 17.059204671313505,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Gospel of John is different  from the Synoptic Gospels\nMatthew, Mark, and Luke",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "customData": {
        "name": "ZB7tQSu0t3opoB3ppWFz7",
