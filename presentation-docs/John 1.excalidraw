    {
      "id": "BBSsVa105kprZGmkNo770",
      "type": "text",
      "x": -2979.630411376254,
      "y": 33240.6455584492,
      "width": 412.1916198730469,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "m_BPlKJLExNAJ5JW9AoPm",
      "index": "b9H",
      "roundness": null,
      "seed": 1918009515,
      "version": 274,
      "versionNonce": 1152877925,
