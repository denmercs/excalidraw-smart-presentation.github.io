      "updated": 1773542515762,
      "link": null,
      "locked": false,
      "text": "The Gospel of John is different  from the Synoptic Gospels\nMatthew, Mark, and Luke",
      "fontSize": 17.059204671313505,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Gospel of John is different  from the Synoptic Gospels\nMatthew, Mark, and Luke",
      "autoResize": false,
      "lineHeight": 1.25,
      "hasTextLink": false,
      "customData": {
        "name": "ZB7tQSu0t3opoB3ppWFz7",
        "revealOrder": 0
      }
    },
    {
      "id": "UAaCD8Phwsn2tttpcz2LL",
      "type": "text",
      "x": -2613.147453988469,
      "y": 19780.42116927135,
      "width": 457.6156311035156,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "WUuao7rr7jiJMvreJqngn",
      "index": "b2zG",
      "roundness": null,
      "seed": 56537701,
      "version": 163,
      "versionNonce": 41644421,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1773542283799,
